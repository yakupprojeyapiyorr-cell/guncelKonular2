# FocusFlow Environment Variables
# Gemini AI Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Database
DATABASE_PASSWORD=focusflow123
DATABASE_URL=jdbc:postgresql://db:5432/focusflow

# JWT Secret
JWT_SECRET=your-super-secret-key-change-in-production

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Upload Directory
UPLOAD_DIR=uploads

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:4173,http://127.0.0.1:5173
